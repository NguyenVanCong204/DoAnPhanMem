<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit user's information</title>
    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">

    <!-- jQuery library -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>

    <!-- Popper JS -->
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>

    <!-- Latest compiled JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        .btn-update{
            border: 1px solid rgb(0, 60, 255);
            padding: 10px 20px;
            background-color: rgb(17, 255, 0);
            color: white;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row">
            <form action="/put-crud" method="POST">    
                <div class="form-row">
                        <div class="col-12 mt-3"><b>Edit user's infomation : </b></div>
                        <div class="form-group col-md-6">
                            <label for="inputEmail4">Firt Name</label>
                            <input type="text" 
                            class="form-control" 
                            placeholder="Firt name" 
                            name="Firtname" 
                            value="<%= user.firstName%>">
                        </div>
                        <div class="form-group col-md-6">
                            <label for="inputPassword4">Last Name</label>
                            <input type="text" class="form-control" name="Lastname" placeholder="Last name" value="<%= user.lastName%>">
                    </div>
                </div>
                <div class="form-group">
                  <label for="inputAddress">Address</label>
                  <input type="text" class="form-control" name="Address" placeholder="1234 Main St" value="<%= user.address%>">
                </div>
                <input type="text" name="id" value="<%= user.id%>">
                <button type="submit" class="btn btn-update ">Update</button>
              </form>
        </div>
    </div>
</body>
</html>